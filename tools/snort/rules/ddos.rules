# DDOS HTTP Flood
alert tcp $HOME_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"DDoS HTTP Flood Detected"; flow:to_server,established; content:"GET"; http_method; threshold:type threshold, track by_src, count 100, seconds 10; classtype:bad-unknown; sid:1000001; rev:1;)
# DDOS SYN Flood
alert tcp $HOME_NET any -> any any (msg:"DDoS SYN Flood Detected"; flags:S; threshold:type threshold, track by_src, count 100, seconds 10; classtype:bad-unknown; sid:1000002; rev:1;)
# DDOS UDP Flood
alert udp $HOME_NET any -> any any (msg:"DDoS UDP Flood Detected"; threshold:type threshold, track by_src, count 100, seconds 10; classtype:bad-unknown; sid:1000003; rev:1;)
# DDOS ICMP Flood
alert icmp $HOME_NET any -> any any (msg:"DDoS ICMP Flood Detected"; threshold:type threshold, track by_src, count 100, seconds 10; classtype:bad-unknown; sid:1000004; rev:1;)